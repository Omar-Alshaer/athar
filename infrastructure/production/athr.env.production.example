NODE_ENV=production
PORT=4200
API_BIND_HOST=127.0.0.1

WEB_ORIGIN=https://STORE_DOMAIN
ADMIN_ORIGIN=https://ADMIN_DOMAIN
API_ORIGIN=https://API_DOMAIN
# Prefer blank (host-only cookies). If required, use only the confirmed parent domain.
COOKIE_DOMAIN=

DATABASE_URL=postgresql://ATHR_DB_USER:STRONG_UNIQUE_DB_PASSWORD@127.0.0.1:5432/ATHR_DB_NAME?schema=public
DIGITAL_STORAGE_ROOT=/var/lib/athr/private

CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_FOLDER=athr-production

PAYMENT_PROVIDER=xpay
MOCK_PAYMENT_ENABLED=false
XPAY_API_BASE_URL=https://api.xpay.app
XPAY_PUBLIC_KEY=YOUR_XPAY_LIVE_PUBLIC_KEY
XPAY_SECRET_KEY=YOUR_XPAY_LIVE_SECRET_KEY
XPAY_WEBHOOK_SECRET=YOUR_XPAY_LIVE_WEBHOOK_SIGNING_SECRET
XPAY_RETURN_URL=https://STORE_DOMAIN/account.html?payment=return
XPAY_CANCEL_URL=https://STORE_DOMAIN/checkout.html?payment=cancelled

SESSION_COOKIE_NAME=athr_session
ADMIN_SESSION_COOKIE_NAME=athr_admin_session
SESSION_TTL_DAYS=30
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_CRYPTOGRAPHICALLY_RANDOM_CHARACTERS
