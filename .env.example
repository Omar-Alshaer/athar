# Copy to .env for local development only. Never commit a populated file.
NODE_ENV=development
PORT=4000
API_BIND_HOST=127.0.0.1

WEB_ORIGIN=http://127.0.0.1:8090
ADMIN_ORIGIN=http://127.0.0.1:3100
API_ORIGIN=http://127.0.0.1:4000
# Leave blank for safer host-only cookies.
COOKIE_DOMAIN=

DATABASE_URL=postgresql://ATHR_DB_USER:ATHR_DB_PASSWORD@127.0.0.1:5434/ATHR_DB_NAME?schema=public
DIGITAL_STORAGE_ROOT=/absolute/path/to/private/athr-storage

CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
CLOUDINARY_FOLDER=athr-production

# Local QA may use mock. Production startup requires xpay + false.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_ENABLED=true
XPAY_API_BASE_URL=https://api.xpay.app
XPAY_PUBLIC_KEY=YOUR_XPAY_PUBLIC_KEY
XPAY_SECRET_KEY=YOUR_XPAY_SECRET_KEY
XPAY_WEBHOOK_SECRET=YOUR_XPAY_WEBHOOK_SIGNING_SECRET
XPAY_RETURN_URL=http://127.0.0.1:8090/account.html?payment=return
XPAY_CANCEL_URL=http://127.0.0.1:8090/checkout.html?payment=cancelled

SESSION_COOKIE_NAME=athr_session
ADMIN_SESSION_COOKIE_NAME=athr_admin_session
SESSION_TTL_DAYS=30
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS

# Supply only for one-time bootstrap, then remove from the environment.
ATHR_ADMIN_EMAIL=ADMIN_EMAIL_PLACEHOLDER
ATHR_ADMIN_PASSWORD=ADMIN_PASSWORD_PLACEHOLDER
ATHR_ADMIN_NAME=ADMIN_NAME_PLACEHOLDER
