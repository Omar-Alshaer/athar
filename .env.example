# ATHR local development
NODE_ENV=development
PORT=4000

# Public application domains
WEB_ORIGIN=https://athar-online.com
ADMIN_ORIGIN=https://admin.athar-online.com
API_ORIGIN=https://api.athar-online.com
COOKIE_DOMAIN=.athar-online.com

# Local PostgreSQL from infrastructure/docker-compose.dev.yml
DATABASE_URL=postgresql://athr:athr_dev_password@localhost:5434/athr?schema=public

# Private digital product storage — book files are never public URLs.
# Use an absolute path on the VPS, e.g. /var/lib/athr/private
DIGITAL_STORAGE_ROOT=

# Cloudinary — images only. Keep API_SECRET server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=athar-online

# Payment abstraction. Keep mock until XPay sandbox credentials are available.
PAYMENT_PROVIDER=mock
# Local mock hosted checkout. Keep false/omitted in production once XPay is enabled.
MOCK_PAYMENT_ENABLED=true
XPAY_API_BASE_URL=
XPAY_PUBLIC_KEY=
XPAY_SECRET_KEY=
XPAY_WEBHOOK_SECRET=

# Authentication secrets — replace with long random values before any shared environment.
SESSION_COOKIE_NAME=athr_session
SESSION_TTL_DAYS=30
SESSION_SECRET=replace-with-at-least-64-random-characters-before-auth-patch

# Admin dashboard — separate session cookie for admin.athar-online.com
ADMIN_SESSION_COOKIE_NAME=athr_admin_session

# One-time/bootstrap super-admin credentials. Prefer injecting these only while
# running `npm run admin:bootstrap`, then remove them from the environment.
ATHR_ADMIN_EMAIL=
ATHR_ADMIN_PASSWORD=
ATHR_ADMIN_NAME=مدير أثر
