{
  "name": "@athr/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prisma:generate && nest start --watch",
    "build": "npm run prisma:generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit",
    "prisma:generate": "prisma generate --config=./prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config=./prisma.config.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio --config=./prisma.config.ts",
    "admin:bootstrap": "npm run prisma:generate && tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cloudinary": "2.10.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@types/cookie-parser": "1.4.9",
    "@types/node": "24.3.0",
    "prisma": "7.9.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
